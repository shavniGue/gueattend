# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=your-secure-random-session-secret-min-32-chars

# Supabase PostgreSQL Configuration
# Reference: cnpullmxupyqdndxzbih
SUPABASE_URL=https://cnpullmxupyqdndxzbih.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://cnpullmxupyqdndxzbih.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Direct Connection String (Pooler or Direct)
# Example: postgresql://postgres.cnpullmxupyqdndxzbih:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.cnpullmxupyqdndxzbih:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Firebase Configuration (Auxiliary Services only: Push, Analytics, Storage)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=gueattend
FIREBASE_AUTH_DOMAIN=gueattend.firebaseapp.com
FIREBASE_STORAGE_BUCKET=gueattend.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=366802350784
FIREBASE_APP_ID=1:366802350784:web:d1222169119b1f56967325
FIREBASE_MEASUREMENT_ID=G-EFR2J8WCH0
# Server-only Firebase Admin Service Account (path, raw JSON string, or base64 JSON — required for assigning `role=authenticated` custom claims)
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebase-service-account.json

# Telegram Bot Integration
# Bot Name: GUE Attendance Bot (@gue_attendance_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=gue_attendance_bot
TELEGRAM_POLLING=on

# Google AdSense / Sponsored Ads (Optional)
ADS_ENABLED=true
# ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# ADSENSE_SLOT_LANDING=1234567890
# ADSENSE_SLOT_DASHBOARD=1234567890
# ADSENSE_SLOT_GUIDE=1234567890
