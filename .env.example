# Database (PostgreSQL / Supabase connection URL)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Application URL
PORT=3000
APP_BASE_URL=http://localhost:3000

# Graphic Era University (GEU) ERP URLs
GEU_BASE_URL=https://student.geu.ac.in
GEU_LOGIN_URL=https://student.geu.ac.in/N0j5Ha0
GEU_TIMETABLE_URL=https://student.geu.ac.in/P0btHKF1DtpZzThe_BuxfULbSZc_QvAAt3MCzUmDOUv7
GEU_DASHBOARD_URL=https://student.geu.ac.in/P0btHKF1DtpZzThe_BuxfULbSZc_QvAAp3scwF-NOlX6

# Backward compatibility aliases
QUMS_LOGIN_URL=https://student.geu.ac.in/N0j5Ha0
QUMS_TIMETABLE_URL=https://student.geu.ac.in/P0btHKF1DtpZzThe_BuxfULbSZc_QvAAt3MCzUmDOUv7
QUMS_DASHBOARD_URL=https://student.geu.ac.in/P0btHKF1DtpZzThe_BuxfULbSZc_QvAAp3scwF-NOlX6

# Intervals & Cadence
ATTENDANCE_TOTAL_CLASSES=40
WATCH_INTERVAL_MINUTES=2
MONTH_REGISTER_INTERVAL_MINUTES=5
MONTH_REGISTER_MONTHS_BACK=5
MONTH_REGISTER_RECENT_EVERY_CYCLES=2
MONTH_REGISTER_OLDER_EVERY_HOURS=6
ASSIGNMENT_INTERVAL_MINUTES=30

# Security (AES-256-GCM encryption key & Session secret)
ENCRYPTION_KEY=
SESSION_SECRET=

# Resend API for transactional emails
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Telegram Bot (BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=gue_attendance_bot

# Node Environment & Admin emails (comma-separated)
NODE_ENV=development
ADMIN_EMAILS=shavnikumarigue@gmail.com

# Firebase Authentication (Public Project ID)
FIREBASE_PROJECT_ID=gueattend
